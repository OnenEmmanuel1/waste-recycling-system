<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<section class="ewrap-pagehead"><div><span class="ewrap-eyebrow">CALABAR DIRECTORY</span><h1>Find a recycling centre</h1><p>Locations are community listings. Call ahead to confirm accepted items and opening hours.</p></div><span class="ewrap-listing-count"><strong><%= centers.length %></strong> listed points</span></section>
<div class="ewrap-map-shell"><div id="ewrap-map" class="ewrap-map" role="application" aria-label="Map of recycling centres in Calabar"></div><div id="ewrap-nearest" class="ewrap-map-note" aria-live="polite">Allow location access to highlight the nearest centre.</div></div>
<div class="ewrap-directory-tools"><div><label for="centerSearch" class="form-label">Search directory</label><input id="centerSearch" class="form-control" type="search" placeholder="Centre, address or neighbourhood"></div><span id="centerResultCount"><%= centers.length %> locations</span></div>
<div class="row g-3" id="centerList"><% centers.forEach((center) => { %><div class="col-lg-6 ewrap-center-entry"><article class="ewrap-card ewrap-center-card h-100" data-search="<%= `${center.name} ${center.address} ${center.description || ''}`.toLowerCase() %>"><div class="d-flex justify-content-between align-items-start gap-3"><span class="ewrap-chip <%= center.certifiedStatus === 'Certified' ? 'ewrap-success' : 'ewrap-neutral' %>"><%= center.certifiedStatus %></span><a class="ewrap-directions" target="_blank" rel="noopener" href="https://www.openstreetmap.org/?mlat=<%= center.latitude %>&mlon=<%= center.longitude %>#map=16/<%= center.latitude %>/<%= center.longitude %>">Directions ↗</a></div><h2><%= center.name %></h2><p class="ewrap-address"><%= center.address %></p><p><%= center.description || 'Contact the centre for details about collection.' %></p><% if (center.contactInfo) { %><a class="ewrap-contact" href="tel:<%= center.contactInfo.replace(/[^+\d]/g, '') %>"><%= center.contactInfo %></a><% } %></article></div><% }) %></div>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" defer></script><script src="/js/map.js" defer></script>
<script src="/js/center-search.js" defer></script>
<%- include('../partials/footer') %>
