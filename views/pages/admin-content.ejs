<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">PUBLIC LEARNING HUB</span><h1>Learning resources</h1><p>Publish practical e-waste guidance and policies for the EWRAP community.</p></div><span class="ewrap-dash-heading-note"><strong><%= articles.length %></strong><span>published resources</span></span></header>
  <section class="ewrap-dash-panel ewrap-dash-form-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">CREATE RESOURCE</span><h2>Publish an article</h2><p>Write a clear, useful resource for campus members.</p></div></div><form class="ewrap-dash-form" action="/admin/articles" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="ewrap-form-grid"><div class="mb-3"><label class="form-label" for="articleTitle">Title</label><input class="form-control" id="articleTitle" name="title" maxlength="150" required></div><div class="mb-3"><label class="form-label" for="articleCategory">Category</label><select class="form-select" id="articleCategory" name="category"><option>Awareness</option><option>Policy</option></select></div></div><div class="mb-3"><label class="form-label" for="articleBody">Content</label><textarea class="form-control" id="articleBody" name="body" rows="6" required></textarea></div><button class="ewrap-btn" type="submit">Publish resource <span aria-hidden="true">→</span></button></form></section>
  <section class="ewrap-dash-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">RESOURCE LIBRARY</span><h2>Published resources</h2></div></div><div class="ewrap-admin-resource-grid">
    <% if (!articles.length) { %><div class="ewrap-dash-empty"><strong>No resources published</strong><span>Use the form above to publish your first article.</span></div><% } %>
    <% articles.forEach((article) => { %><details class="ewrap-resource-card"><summary><span class="ewrap-chip ewrap-neutral"><%= article.category %></span><strong><%= article.title %></strong><small>Published <%= new Date(article.publishedAt).toLocaleDateString('en-NG') %></small></summary><div class="ewrap-resource-edit"><form class="ewrap-edit-form" action="/admin/articles" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="articleId" value="<%= article.articleId %>"><div class="mb-3"><label class="form-label">Title</label><input class="form-control" name="title" value="<%= article.title %>" maxlength="150" required></div><div class="mb-3"><label class="form-label">Category</label><select class="form-select" name="category"><option <%= article.category==='Awareness'?'selected':'' %>>Awareness</option><option <%= article.category==='Policy'?'selected':'' %>>Policy</option></select></div><div class="mb-3"><label class="form-label">Content</label><textarea class="form-control" name="body" rows="7" required><%= article.body %></textarea></div><button class="ewrap-btn ewrap-tiny" type="submit">Save changes</button></form><form class="ewrap-manage-delete" action="/admin/articles/<%= article.articleId %>/delete" method="post" data-confirm="Delete this published article?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ewrap-btn ewrap-tiny ewrap-danger" type="submit">Delete resource</button></form></div></details><% }) %>
  </div></section>
</div></div><%- include('../partials/footer') %>
