<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">COMMUNITY ACCESS</span><h1>Members and access</h1><p>Review registered members and provision administrator accounts for platform management.</p></div><span class="ewrap-dash-heading-note"><strong><%= users.length %></strong><span>registered members</span></span></header>
  <div class="ewrap-admin-manage-grid"><section class="ewrap-dash-panel ewrap-dash-form-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">STAFF ACCESS</span><h2>Add administrator</h2><p>Create an institution-managed account. Public sign-up remains member-only.</p></div></div><form class="ewrap-dash-form" action="/admin/users" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="mb-3"><label class="form-label" for="adminFullName">Full name</label><input class="form-control" id="adminFullName" name="fullName" maxlength="100" required></div><div class="mb-3"><label class="form-label" for="adminEmail">Email address</label><input class="form-control" id="adminEmail" name="email" type="email" required></div><div class="mb-3"><label class="form-label" for="adminPassword">Temporary password</label><input class="form-control" id="adminPassword" name="password" type="password" minlength="10" autocomplete="new-password" required></div><div class="mb-4"><label class="form-label" for="adminAffiliation">Affiliation</label><input class="form-control" id="adminAffiliation" name="affiliation" maxlength="60"></div><button class="ewrap-btn" type="submit">Create administrator</button></form></section>
  <section class="ewrap-dash-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">EWRAP COMMUNITY</span><h2>Registered members</h2></div></div><div class="ewrap-dash-list ewrap-member-list">
    <% if (!users.length) { %><div class="ewrap-dash-empty"><strong>No registered members</strong><span>New public registrations will appear here.</span></div><% } %>
    <% users.forEach((user) => { %><article class="ewrap-user-row"><span class="ewrap-avatar"><%= user.fullName.slice(0,1).toUpperCase() %></span><span><strong><%= user.fullName %></strong><small><%= user.email %></small></span><span class="ewrap-member-meta"><%= user.affiliation || 'Member' %><small>Joined <%= new Date(user.createdAt).toLocaleDateString('en-NG') %></small></span></article><% }) %>
  </div></section></div>
</div></div><%- include('../partials/footer') %>
