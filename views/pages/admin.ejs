<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">PLATFORM OVERVIEW</span><h1>Good day, <%= currentUser.fullName.split(' ')[0] %></h1><p>Monitor EWRAP activity and manage campus recycling services from one place.</p></div><a class="ewrap-btn ewrap-outline" href="/api/analytics" target="_blank" rel="noopener">Open analytics data <span aria-hidden="true">↗</span></a></header>
  <section class="ewrap-dash-stats" aria-label="Platform summary">
    <a class="ewrap-dash-stat" href="/admin/reports"><span class="ewrap-dash-stat-label">Total reports</span><span class="ewrap-dash-stat-icon">R</span><strong><%= totals.reports %></strong><small>All submitted e-waste reports</small></a>
    <a class="ewrap-dash-stat ewrap-dash-stat-alert" href="/admin/reports"><span class="ewrap-dash-stat-label">Waiting for review</span><span class="ewrap-dash-stat-icon">…</span><strong><%= totals.unreviewed %></strong><small>Pending reports in the queue</small></a>
    <a class="ewrap-dash-stat" href="/admin/centers"><span class="ewrap-dash-stat-label">Collection centres</span><span class="ewrap-dash-stat-icon">⌖</span><strong><%= totals.centers %></strong><small>Points listed in the directory</small></a>
    <a class="ewrap-dash-stat ewrap-dash-stat-highlight" href="/admin/users"><span class="ewrap-dash-stat-label">Community members</span><span class="ewrap-dash-stat-icon">M</span><strong><%= totals.members %></strong><small><%= totals.logs %> recycling actions recorded</small></a>
  </section>
  <section class="ewrap-dash-panel ewrap-dash-analytics"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">COMMUNITY TRENDS</span><h2>Platform activity</h2><p>Compare the reported item types and monthly recycling activity.</p></div><span class="ewrap-chip ewrap-success">Live data</span></div><div class="ewrap-admin-analytics-grid"><div class="ewrap-analytics-block"><h3>Reports by item type</h3><div id="ewrap-analytics" class="ewrap-bars" aria-live="polite">Loading report aggregates…</div></div><div class="ewrap-analytics-block"><h3>Monthly recycling activity</h3><div id="ewrap-monthly" class="ewrap-month-grid">Loading activity…</div></div></div></section>
  <section class="ewrap-dash-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">NEEDS ATTENTION</span><h2>Recent reports</h2></div><a href="/admin/reports">Open review queue <span aria-hidden="true">→</span></a></div><div class="ewrap-dash-list">
    <% if (!recentReports.length) { %><div class="ewrap-dash-empty"><strong>All caught up</strong><span>New e-waste reports will appear here for review.</span></div><% } %>
    <% recentReports.forEach((report) => { %><a class="ewrap-dash-row ewrap-dash-row-link" href="/admin/reports"><span class="ewrap-dash-row-mark">R</span><span class="ewrap-dash-row-copy"><strong><%= report.itemType %></strong><small><%= report.fullName %> · <%= new Date(report.reportedAt).toLocaleDateString('en-NG') %></small></span><span class="ewrap-status ewrap-<%= report.status.toLowerCase() %>"><%= report.status %></span></a><% }) %>
  </div></section>
</div></div><script src="/js/analytics.js" defer></script><%- include('../partials/footer') %>
