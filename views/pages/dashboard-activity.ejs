<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">YOUR CONTRIBUTION</span><h1>Recycling activity</h1><p>Keep a record of what you recycled, where you dropped it off, and your experience.</p></div><a class="ewrap-btn ewrap-outline" href="/centers">Browse centres <span aria-hidden="true">↗</span></a></header>
  <section class="ewrap-dash-panel ewrap-dash-form-panel" id="log-activity"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">RECORD A DROP-OFF</span><h2>Log recycling activity</h2><p>Share a drop-off so your contribution becomes part of the campus record.</p></div></div>
    <form class="ewrap-dash-form" action="/logs" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="ewrap-form-grid"><div class="mb-3"><label class="form-label" for="logItem">Item type</label><input class="form-control" id="logItem" name="itemType" maxlength="100" placeholder="e.g. mobile phone" required></div><div class="mb-3"><label class="form-label" for="logQuantity">Quantity</label><input class="form-control" id="logQuantity" name="quantity" maxlength="60" placeholder="e.g. 2 devices or 1 kg" required></div><div class="mb-3"><label class="form-label" for="centerId">Collection centre</label><select class="form-select" id="centerId" name="centerId"><option value="">Other / not listed</option><% centers.forEach((center) => { %><option value="<%= center.centerId %>"><%= center.name %></option><% }) %></select></div><div class="mb-3"><label class="form-label" for="rating">Rate the drop-off</label><select class="form-select" id="rating" name="rating"><option value="">Skip rating</option><% for(let n=5;n>=1;n--) { %><option value="<%= n %>"><%= n %> / 5</option><% } %></select></div><div class="mb-3 ewrap-form-grid-wide"><label class="form-label" for="message">Feedback <span class="ewrap-muted">(optional)</span></label><textarea class="form-control" id="message" name="message" maxlength="2000" rows="3" placeholder="How was the drop-off?"></textarea></div></div><button class="ewrap-btn" type="submit">Save activity <span aria-hidden="true">→</span></button></form>
  </section>
  <section class="ewrap-dash-panel ewrap-dash-table-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">YOUR HISTORY</span><h2>Recorded drop-offs</h2></div><span class="ewrap-listing-count"><strong><%= logs.length %></strong> total</span></div><div class="table-responsive"><table class="table ewrap-table align-middle mb-0"><thead><tr><th>Item</th><th>Quantity</th><th>Centre</th><th>Date</th><th>Rating</th><th>Actions</th></tr></thead><tbody>
    <% if (!logs.length) { %><tr><td colspan="6" class="ewrap-empty">No activities recorded yet. Use the form above after your next drop-off.</td></tr><% } %>
    <% logs.forEach((log) => { %><tr><td><strong><%= log.itemType %></strong></td><td><%= log.quantity %></td><td><%= log.centerName || 'Other location' %></td><td><%= new Date(log.loggedAt).toLocaleDateString('en-NG') %></td><td><%= log.rating ? `${log.rating} / 5` : '—' %></td><td><details class="ewrap-row-edit"><summary>Edit</summary><form method="post" action="/logs/<%= log.logId %>/update"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">Item<input class="form-control" name="itemType" value="<%= log.itemType %>" required></label><label class="form-label">Quantity<input class="form-control" name="quantity" value="<%= log.quantity %>" required></label><label class="form-label">Centre<select class="form-select" name="centerId"><option value="">Other / not listed</option><% centers.forEach((center) => { %><option value="<%= center.centerId %>" <%= String(center.centerId)===String(log.centerId)?'selected':'' %>><%= center.name %></option><% }) %></select></label><button class="ewrap-btn ewrap-tiny" type="submit">Save changes</button></form><form class="mt-2" method="post" action="/logs/<%= log.logId %>/delete" data-confirm="Delete this recycling activity?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ewrap-delete-link" type="submit">Delete activity</button></form></details></td></tr><% }) %>
  </tbody></table></div></section>
</div></div><%- include('../partials/footer') %>
