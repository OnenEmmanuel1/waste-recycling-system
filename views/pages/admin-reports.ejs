<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">REPORT MANAGEMENT</span><h1>Report review</h1><p>Review campus e-waste submissions, update their status, and follow up on collection needs.</p></div><div class="ewrap-dash-heading-note"><strong><%= reports.filter((report) => report.status === 'Pending').length %></strong><span>pending review</span></div></header>
  <section class="ewrap-dash-panel ewrap-dash-table-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">REVIEW QUEUE</span><h2>Submitted reports</h2><p>Pending items are listed first.</p></div><span class="ewrap-listing-count"><strong><%= reports.length %></strong> total</span></div><div class="table-responsive"><table class="table ewrap-table align-middle mb-0"><thead><tr><th>Submitted by</th><th>Item</th><th>Campus location</th><th>Date</th><th>Photo</th><th>Status</th><th>Update</th></tr></thead><tbody>
    <% if (!reports.length) { %><tr><td colspan="7" class="ewrap-empty">No e-waste reports have been submitted.</td></tr><% } %>
    <% reports.forEach((report) => { %><tr><td><strong><%= report.fullName %></strong><small><%= report.email %></small></td><td><strong><%= report.itemType %></strong><small><%= report.estimatedQuantity || 'Quantity not provided' %></small></td><td><%= report.campusLocation %></td><td><%= new Date(report.reportedAt).toLocaleDateString('en-NG') %></td><td><% if(report.photoPath) { %><a href="/photos/<%= encodeURIComponent(report.photoPath) %>" target="_blank" rel="noopener">View photo</a><% } else { %><span class="ewrap-muted">—</span><% } %></td><td><span class="ewrap-status ewrap-<%= report.status.toLowerCase() %>"><%= report.status %></span></td><td><form class="ewrap-inline-form" action="/admin/reports/<%= report.reportId %>/status" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><select class="form-select form-select-sm" name="status" aria-label="Report status"><% ['Pending','Reviewed','Resolved'].forEach((status) => { %><option <%= report.status === status ? 'selected' : '' %>><%= status %></option><% }) %></select><button class="ewrap-btn ewrap-tiny" type="submit">Save</button></form></td></tr><% }) %>
  </tbody></table></div></section>
</div></div><%- include('../partials/footer') %>
