<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<section class="ewrap-pagehead"><div><span class="ewrap-eyebrow"><%= category === 'Policy' ? 'POLICY & MANAGEMENT' : 'KNOWLEDGE HUB' %></span><h1><%= category === 'Policy' ? 'Policy and management' : 'E-waste awareness' %></h1><p><%= category === 'Policy' ? 'Guidance for responsible institutional and community practice.' : 'Practical advice for safe handling and responsible recycling.' %></p></div></section>
<div class="row g-3"><% if (!articles.length) { %><div class="col-12"><div class="ewrap-empty">No published resources yet.</div></div><% } %><% articles.forEach((article) => { %><div class="col-lg-6"><article class="ewrap-card ewrap-article h-100"><span class="ewrap-chip"><%= article.category %></span><h2><%= article.title %></h2><div class="ewrap-article-body"><%= article.body %></div><p class="ewrap-byline">Published <time datetime="<%= article.publishedAt.toISOString ? article.publishedAt.toISOString() : article.publishedAt %>"><%= new Date(article.publishedAt).toLocaleDateString('en-NG',{year:'numeric',month:'long',day:'numeric'}) %></time><% if (article.author) { %> · <%= article.author %><% } %></p></article></div><% }) %></div>
<%- include('../partials/footer') %>
