<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">DIRECTORY MANAGEMENT</span><h1>Collection centres</h1><p>Keep campus members connected to trusted e-waste drop-off locations.</p></div><span class="ewrap-dash-heading-note"><strong><%= centers.length %></strong><span>listed centres</span></span></header>
  <div class="ewrap-admin-manage-grid"><section class="ewrap-dash-panel ewrap-dash-form-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">ADD TO DIRECTORY</span><h2>New collection point</h2><p>Enter its name, contact details, and map coordinates.</p></div></div><form class="ewrap-dash-form" action="/admin/centers" method="post"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="mb-3"><label class="form-label" for="centerName">Centre name</label><input class="form-control" id="centerName" name="name" maxlength="150" required></div><div class="mb-3"><label class="form-label" for="centerAddress">Address</label><input class="form-control" id="centerAddress" name="address" maxlength="200" required></div><div class="ewrap-form-grid"><div class="mb-3"><label class="form-label" for="latitude">Latitude</label><input class="form-control" id="latitude" name="latitude" type="number" step="0.000001" required></div><div class="mb-3"><label class="form-label" for="longitude">Longitude</label><input class="form-control" id="longitude" name="longitude" type="number" step="0.000001" required></div></div><div class="mb-3"><label class="form-label" for="certification">Certification</label><select class="form-select" id="certification" name="certifiedStatus"><option>Unverified</option><option>Certified</option></select></div><div class="mb-3"><label class="form-label" for="contactInfo">Contact</label><input class="form-control" id="contactInfo" name="contactInfo" maxlength="150"></div><div class="mb-4"><label class="form-label" for="description">Description</label><textarea class="form-control" id="description" name="description" rows="3" maxlength="10000"></textarea></div><button class="ewrap-btn" type="submit">Add centre <span aria-hidden="true">+</span></button></form></section>
  <section class="ewrap-dash-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">PUBLIC DIRECTORY</span><h2>Listed locations</h2></div></div><div class="ewrap-dash-list ewrap-manage-list">
    <% if (!centers.length) { %><div class="ewrap-dash-empty"><strong>No collection centres yet</strong><span>Add a centre to make it available in the public directory.</span></div><% } %>
    <% centers.forEach((center) => { %><details class="ewrap-manage-item"><summary><span><strong><%= center.name %></strong><small><%= center.address %></small></span><span class="ewrap-chip <%= center.certifiedStatus === 'Certified' ? 'ewrap-success' : 'ewrap-neutral' %>"><%= center.certifiedStatus %></span></summary><div class="ewrap-edit-wrap"><form action="/admin/centers" method="post" class="ewrap-edit-form"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="centerId" value="<%= center.centerId %>"><div class="mb-2"><label class="form-label">Centre name</label><input class="form-control" name="name" value="<%= center.name %>" maxlength="150" required></div><div class="mb-2"><label class="form-label">Address</label><input class="form-control" name="address" value="<%= center.address %>" maxlength="200" required></div><div class="ewrap-form-grid"><div class="mb-2"><label class="form-label">Latitude</label><input class="form-control" name="latitude" type="number" step="0.000001" value="<%= center.latitude %>" required></div><div class="mb-2"><label class="form-label">Longitude</label><input class="form-control" name="longitude" type="number" step="0.000001" value="<%= center.longitude %>" required></div></div><div class="ewrap-form-grid"><div class="mb-2"><label class="form-label">Certification</label><select class="form-select" name="certifiedStatus"><option <%= center.certifiedStatus==='Unverified'?'selected':'' %>>Unverified</option><option <%= center.certifiedStatus==='Certified'?'selected':'' %>>Certified</option></select></div><div class="mb-2"><label class="form-label">Contact</label><input class="form-control" name="contactInfo" value="<%= center.contactInfo || '' %>" maxlength="150"></div></div><div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="description" rows="2" maxlength="10000"><%= center.description || '' %></textarea></div><button class="ewrap-btn ewrap-tiny" type="submit">Save changes</button></form><form class="ewrap-manage-delete" method="post" action="/admin/centers/<%= center.centerId %>/delete" data-confirm="Delete this centre? Existing activity will retain its record without the centre link."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ewrap-btn ewrap-tiny ewrap-danger" type="submit">Delete centre</button></form></div></details><% }) %>
  </div></section></div>
</div></div><%- include('../partials/footer') %>
