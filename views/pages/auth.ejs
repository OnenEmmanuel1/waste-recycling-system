<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-auth-shell"><aside class="ewrap-auth-visual"><div class="ewrap-auth-photo" role="img" aria-label="Recycling bottles placed into a box marked with the recycling symbol"></div><div class="ewrap-auth-shade" aria-hidden="true"></div><a class="ewrap-auth-brand" href="/" aria-label="EWRAP home"><img src="/images/ewrap-logo.svg" alt=""><span><strong>EWRAP</strong><small>UNICROSS · CALABAR</small></span></a><div class="ewrap-auth-message"><span>SMALL ACTIONS, CLEANER FUTURE</span><h2>Give every old device a better next chapter.</h2><p>Learn how to recycle electronics responsibly and protect our environment.</p></div></aside><div class="ewrap-auth-form-side"><section class="ewrap-auth-card ewrap-card"><span class="ewrap-eyebrow"><%= mode === 'login' ? 'MEMBER ACCESS' : 'JOIN THE COMMUNITY' %></span><h1><%= mode === 'login' ? 'Welcome back' : 'Create your account' %></h1><p><%= mode === 'login' ? 'Sign in to manage your reports and recycling history.' : 'Create an account to report campus e-waste and record your recycling actions.' %></p>
<form method="post" action="/<%= mode %>" class="mt-4"><input type="hidden" name="_csrf" value="<%= csrf %>">
  <% if (mode === 'register') { %><div class="mb-3"><label class="form-label" for="fullName">Full name</label><input class="form-control" id="fullName" name="fullName" autocomplete="name" maxlength="100" required></div><% } %>
  <div class="mb-3"><label class="form-label" for="email">Email address</label><input class="form-control" id="email" type="email" name="email" autocomplete="email" maxlength="100" required></div>
  <div class="mb-3"><label class="form-label" for="password">Password</label><input class="form-control" id="password" type="password" name="password" autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>" minlength="<%= mode === 'register' ? 10 : 1 %>" required><% if (mode === 'register') { %><div class="form-text">Use at least 10 characters.</div><% } %></div>
  <% if (mode === 'register') { %><div class="mb-4"><label class="form-label" for="affiliation">I am a… <span class="ewrap-muted">(optional)</span></label><select class="form-select" id="affiliation" name="affiliation"><option value="">Choose affiliation</option><option>Student</option><option>Staff</option><option>Business</option><option>Public</option></select></div><% } %>
  <button class="ewrap-btn w-100" type="submit"><%= mode === 'login' ? 'Sign in' : 'Create account' %></button>
</form><p class="ewrap-auth-switch"><%= mode === 'login' ? 'New to EWRAP?' : 'Already a member?' %> <a href="/<%= mode === 'login' ? 'register' : 'login' %>"><%= mode === 'login' ? 'Create an account' : 'Sign in' %></a></p></section></div></div>
<%- include('../partials/footer') %>
