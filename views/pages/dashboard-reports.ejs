<%- include('../partials/header', { title, currentPath, currentUser, csrf, flash, appName }) %>
<div class="ewrap-dashboard"><%- include('../partials/dashboard-nav', { currentPath, currentUser, csrf }) %><div class="ewrap-dash-main">
  <header class="ewrap-dash-heading"><div><span class="ewrap-eyebrow">CAMPUS REPORTING</span><h1>My reports</h1><p>Submit e-waste for collection and follow each report through review.</p></div><a class="ewrap-btn ewrap-outline" href="/centers">Find a centre <span aria-hidden="true">↗</span></a></header>
  <section class="ewrap-dash-panel ewrap-dash-form-panel" id="new-report"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">NEW SUBMISSION</span><h2>Report e-waste</h2><p>Give the team enough detail to locate and prepare your items.</p></div></div>
    <form class="ewrap-dash-form" action="/reports" method="post" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="<%= csrf %>"><div class="ewrap-form-grid"><div class="mb-3"><label class="form-label" for="reportItem">Item type</label><input class="form-control" id="reportItem" name="itemType" maxlength="100" placeholder="e.g. laptop batteries" required></div><div class="mb-3"><label class="form-label" for="estimatedQuantity">Estimated quantity</label><input class="form-control" id="estimatedQuantity" name="estimatedQuantity" maxlength="60" placeholder="e.g. 4 devices"></div><div class="mb-3"><label class="form-label" for="campusLocation">Campus location</label><input class="form-control" id="campusLocation" name="campusLocation" maxlength="150" placeholder="Building, department or area" required></div><div class="mb-3"><label class="form-label" for="photo">Photo <span class="ewrap-muted">(optional, JPG/PNG/WebP)</span></label><input class="form-control" id="photo" name="photo" type="file" accept="image/jpeg,image/png,image/webp"></div></div><button class="ewrap-btn" type="submit">Send report <span aria-hidden="true">→</span></button></form>
  </section>
  <section class="ewrap-dash-panel ewrap-dash-table-panel"><div class="ewrap-dash-panel-head"><div><span class="ewrap-eyebrow">REPORT HISTORY</span><h2>Submitted reports</h2></div><span class="ewrap-listing-count"><strong><%= reports.length %></strong> total</span></div><div class="table-responsive"><table class="table ewrap-table align-middle mb-0"><thead><tr><th>Item</th><th>Campus location</th><th>Reported</th><th>Status</th><th>Photo</th><th>Actions</th></tr></thead><tbody>
    <% if (!reports.length) { %><tr><td colspan="6" class="ewrap-empty">No reports yet. Use the form above to make your first submission.</td></tr><% } %>
    <% reports.forEach((report) => { %><tr><td><strong><%= report.itemType %></strong><small><%= report.estimatedQuantity || 'Quantity not provided' %></small></td><td><%= report.campusLocation %></td><td><%= new Date(report.reportedAt).toLocaleDateString('en-NG') %></td><td><span class="ewrap-status ewrap-<%= report.status.toLowerCase() %>"><%= report.status %></span></td><td><% if(report.photoPath) { %><a href="/photos/<%= encodeURIComponent(report.photoPath) %>" target="_blank" rel="noopener">View photo</a><% } else { %><span class="ewrap-muted">—</span><% } %></td><td><details class="ewrap-row-edit"><summary>Edit</summary><form method="post" action="/reports/<%= report.reportId %>/update"><input type="hidden" name="_csrf" value="<%= csrf %>"><label class="form-label">Item<input class="form-control" name="itemType" value="<%= report.itemType %>" required></label><label class="form-label">Quantity<input class="form-control" name="estimatedQuantity" value="<%= report.estimatedQuantity || '' %>"></label><label class="form-label">Location<input class="form-control" name="campusLocation" value="<%= report.campusLocation %>" required></label><button class="ewrap-btn ewrap-tiny" type="submit">Save changes</button></form><form class="mt-2" method="post" action="/reports/<%= report.reportId %>/delete" data-confirm="Delete this report?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="ewrap-delete-link" type="submit">Delete report</button></form></details></td></tr><% }) %>
  </tbody></table></div></section>
</div></div><%- include('../partials/footer') %>
