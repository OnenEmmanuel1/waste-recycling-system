# Copy this file to .env and replace SESSION_SECRET with a unique random value.
APP_NAME=EWRAP
NODE_ENV=development
APP_PORT=3000
DEV_PORT=3000
APP_URL=http://localhost:3000
APP_TIMEZONE=Africa/Lagos
APP_DEBUG=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ewrap
DB_USER=ewrap_app
DB_CONNECTION_LIMIT=10
DB_FORWARD_PORT=3309

SESSION_SECRET=replace-with-a-long-random-session-secret
SESSION_SECURE=0
SESSION_MAX_AGE_HOURS=8

# Report images are kept outside public/ and are served through an access-checked route.
UPLOADS_DIR=./uploads
MAX_PHOTO_UPLOAD_MB=5
